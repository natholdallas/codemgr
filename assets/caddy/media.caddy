# Auto-generated by main.sh (media endpoint) — edit main.sh domains[] and re-run webconf
# Media files are encrypted at rest: this host only proxies to the backend
# route that decrypts them, never to a file server.
@DOMAIN@ {
    encode gzip zstd

    handle {
        rewrite * /media{uri}
        reverse_proxy @API_ADDR@
    }
}
