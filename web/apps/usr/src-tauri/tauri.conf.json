{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codemgr Vault",
  "version": "0.1.0",
  "identifier": "club.hnath.codemgr",
  "build": {
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codemgr Vault",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
